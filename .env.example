# Example environment overrides for DevRay DataLab MCP
DEVRAY_WORKSPACE_DIR=datasets
DEVRAY_ARTIFACTS_DIR=artifacts
DEVRAY_MAX_DATASET_SIZE_BYTES=209715200
DEVRAY_MAX_PREVIEW_ROWS=25
DEVRAY_MAX_CPU_THREADS=
